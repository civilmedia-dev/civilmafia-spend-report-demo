# --- BigQuery (solo servidor) ---
BIGQUERY_PROJECT_ID=civil-datalake
BIGQUERY_DATASET=windsor_gbq_civil
BIGQUERY_LOCATION=US

# Local: ruta a un JSON de service account (no lo subas al repo).
# Si queda vacío se usa Application Default Credentials (gcloud auth application-default login).
BIGQUERY_CREDENTIALS_PATH=

# Vercel: credenciales de la service account como variables de entorno.
GCP_CLIENT_EMAIL=spend-report@civil-datalake.iam.gserviceaccount.com
# Pega la clave con los \n literales; el código los convierte a saltos de línea.
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREEMPLAZAR\n-----END PRIVATE KEY-----\n"

# --- Acceso al reporte (opcional, recomendado en producción) ---
# Si se definen ambos, el sitio pide usuario y contraseña (HTTP Basic Auth).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Minutos que se reutiliza el resultado de BigQuery antes de volver a consultar.
SPEND_CACHE_MINUTES=60
